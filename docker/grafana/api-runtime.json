{
  "uid": "api-runtime",
  "title": "API Runtime — Mémoire & CPU des backends",
  "tags": [
    "heroes-powers",
    "runtime",
    "otel"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Mémoire résidente (RSS) par backend",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "rss",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_memory_usage_bytes{service_name=~\"nest-api|rust-api|sample-api\"} or process_memory_rss_bytes{service_name=~\"nest-api|rust-api|sample-api\"}",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Mémoire du heap .NET (sample-api)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "heap",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "dotnet_gc_heap_size_bytes{service_name=\"sample-api\"}",
          "legendFormat": "GC heap"
        },
        {
          "refId": "gen0",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "dotnet_gc_allocation_rate_bytes{service_name=\"sample-api\"}",
          "legendFormat": "Allocation rate"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Mémoire du heap Node.js (nest-api)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "heap",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_gc_heap_size_used_bytes{service_name=\"nest-api\"} or process_heap_usage_bytes{service_name=\"nest-api\"}",
          "legendFormat": "Heap used"
        },
        {
          "refId": "eventloop",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_eventloop_delay_mean_seconds{service_name=\"nest-api\"}",
          "legendFormat": "Event loop delay (s)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU — temps cumulé par backend",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "cpu",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_cpu_time_seconds{service_name=~\"nest-api|rust-api|sample-api\"} or process_cpu_seconds_total{service_name=~\"nest-api|rust-api|sample-api\"}",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU — utilisation relative par backend",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "util",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_cpu_utilization_ratio{service_name=~\"nest-api|rust-api|sample-api\"} or process_cpu_utilization{service_name=~\"nest-api|rust-api|sample-api\"}",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Threads & uptime par backend",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "threads",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_threads{service_name=~\"nest-api|rust-api|sample-api\"} or dotnet_threadpool_thread_count{service_name=\"sample-api\"}",
          "legendFormat": "threads {{service_name}}"
        },
        {
          "refId": "uptime",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_uptime_seconds{service_name=~\"nest-api|rust-api|sample-api\"}",
          "legendFormat": "uptime {{service_name}}"
        }
      ]
    }
  ]
}
