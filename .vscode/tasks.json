{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-nest-backend",
      "type": "process",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/NestApi"
      },
      "group": "build",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "build-backend",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/SampleApi/SampleApi.csproj"],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "type": "docker-build",
      "label": "docker-build: debug",
      "dockerBuild": {
        "tag": "sampleapi:debug",
        "context": "${workspaceFolder}/SampleApi",
        "dockerfile": "${workspaceFolder}/SampleApi/Dockerfile.debug"
      }
    },
    {
      "type": "docker-run",
      "label": "docker-run: debug",
      "dependsOn": ["docker-build: debug"],
      "dockerRun": {
        "containerName": "sampleapi-debug",
        "image": "sampleapi:debug",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "DATA_PATH": "/data"
        },
        "ports": [{ "containerPort": 5025, "hostPort": 5025 }],
        "volumes": [
          {
            "localPath": "${workspaceFolder}/SampleApi/.data",
            "containerPath": "/data"
          }
        ],
        "remove": false
      },
      "netCore": {
        "appProject": "${workspaceFolder}/SampleApi/SampleApi.csproj",
        "enableDebugging": true
      }
    },
    {
      "type": "docker-build",
      "label": "docker-build: nest-api",
      "dockerBuild": {
        "tag": "nest-api:latest",
        "context": "${workspaceFolder}/NestApi",
        "dockerfile": "${workspaceFolder}/NestApi/Dockerfile"
      }
    },
    {
      "type": "docker-run",
      "label": "docker-run: nest-api",
      "dependsOn": ["docker-build: nest-api"],
      "dockerRun": {
        "image": "nest-api:latest",
        "env": {
          "PORT": "3000",
          "DATABASE_URL": "mysql://heroes_app:heroes_app@host.docker.internal:3306/nest_api",
          "JSON_SEED_DATA_PATH": "/app/.data"
        },
        "ports": [{ "containerPort": 3000, "hostPort": 3000 }],
        "customOptions": "--add-host=host.docker.internal:host-gateway",
        "remove": true
      },
      "node": {
        "enableDebugging": true,
        "package": "${workspaceFolder}/NestApi/package.json"
      }
    },
    {
      "type": "docker-build",
      "label": "docker-build: rust-api",
      "dockerBuild": {
        "tag": "rust-api:latest",
        "context": "${workspaceFolder}/RustApi",
        "dockerfile": "${workspaceFolder}/RustApi/Dockerfile"
      }
    },
    {
      "type": "docker-run",
      "label": "docker-run: rust-api",
      "dependsOn": ["docker-build: rust-api"],
      "dockerRun": {
        "image": "rust-api:latest",
        "env": {
          "PORT": "3000",
          "DATABASE_URL": "mysql://heroes_app:heroes_app@host.docker.internal:3306/rust_api",
          "JSON_SEED_ENABLED": "true",
          "JSON_SEED_DATA_PATH": "/app/.data",
          "RUST_LOG": "rust_api=info"
        },
        "ports": [{ "containerPort": 3000, "hostPort": 3001 }],
        "customOptions": "--add-host=host.docker.internal:host-gateway",
        "remove": true
      }
    }
  ]
}
